    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "pptxgenjs": "^4.0.1",
    "selfsigned": "^5.5.0"
