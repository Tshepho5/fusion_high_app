{
  "name": "fusion-high-app",
  "version": "2.1.0",
  "description": "Geleza SA — CAPS-aligned school management & learning platform (FUSION_HIGH_APP 2.1)",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --delay 1 server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:client",
    "test": "node --test tests/critical-path.test.js tests/learner-csv-import.test.js",
    "test:critical": "node --test tests/critical-path.test.js tests/learner-csv-import.test.js",
    "test:ai": "node --test tests/geleza-ai.test.js",
    "test:ai:auto": "node tests/geleza-ai-automation.test.js",
    "scan:secrets": "node scripts/scan-secrets.js",
    "docs:pdf": "node docs/geleza-sa-project-guide/generate-geleza-sa-pdf.js",
    "docs:exec": "node docs/geleza-sa-project-guide/generate-executive-brief.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@simplewebauthn/server": "^13.2.2",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "pptxgenjs": "^4.0.1",
    "selfsigned": "^5.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "puppeteer-core": "^25.9.0"
  },
  "keywords": [
    "sms",
    "school",
    "management",
    "postgres"
  ],
  "author": "Fusion High Dev Team",
  "license": "ISC"
}
