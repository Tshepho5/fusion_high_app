# Geleza SA / Fusion High — environment template
# Copy to .env and fill real values. Never commit .env.

NODE_ENV=development
PORT=4000
HTTPS_PORT=4001

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/geleza_sa
# Or discrete fields if your db/db.js prefers them:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=geleza_sa

# Auth
JWT_SECRET=replace-with-long-random-string
SESSION_SECRET=replace-with-another-long-random-string

# Public URLs
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000

# SMTP (OTP, support acknowledgements, admissions)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Geleza SA <noreply@gelezasa.co.za>"

# Firebase Admin (path only — keep JSON out of git)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json

# Optional AI
# GEMINI_API_KEY=

# Logging
LOG_LEVEL=info
